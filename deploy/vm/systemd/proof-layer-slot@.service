[Unit]
Description=Proof Layer workspace %i (app)
After=network.target postgresql.service
Wants=postgresql.service
StartLimitIntervalSec=0

[Service]
User=prooflayer
Group=prooflayer
EnvironmentFile=/etc/proof-layer/slot-%i.env
WorkingDirectory=/opt/proof-layer/app/proof-layer
ExecStart=/opt/proof-layer/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${PORT}
Restart=always
RestartSec=2
MemoryMax=900M
CPUQuota=200%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/proof-layer

[Install]
WantedBy=multi-user.target
